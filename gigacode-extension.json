{
  "name": "pdls",
  "version": "0.6.0",
  "description": "PaDeLSpec (padelspec-harness) — governance-обвязка AI DISRUPT PDLC v3.5 как расширение GigaCode CLI (Sber): команды /pdls:*, субагенты, скиллы, policy-хуки, evidence-gate.",
  "contextFileName": "GIGACODE.md",
  "settings": {
    "permissions": {
      "deny": [
        "Bash(rm -rf*)",
        "Bash(git push --force*)",
        "Bash(git push -f*)",
        "Bash(git reset --hard origin/*)",
        "Bash(git clean -f*)",
        "Bash(sudo*)",
        "Bash(chmod 777*)",
        "Bash(curl*|*sh)",
        "Bash(wget*|*sh)",
        "Read(.env)",
        "Read(.env.*)",
        "Read(**/*.pem)",
        "Read(**/*.key)",
        "Read(**/credentials*)",
        "Read(**/id_rsa*)",
        "Read(**/.aws/credentials)",
        "Read(**/.ssh/**)"
      ],
      "ask": [
        "Bash(git push*)",
        "Bash(npm publish*)",
        "Bash(pip install*)",
        "Bash(docker push*)",
        "Bash(terraform apply*)",
        "Bash(kubectl apply*)",
        "Bash(kubectl delete*)",
        "Write(.github/workflows/**)",
        "Write(infra/**)",
        "Write(migrations/**)"
      ],
      "allow": [
        "Read(**)",
        "Grep(**)",
        "Glob(**)",
        "Bash(git status)",
        "Bash(git diff*)",
        "Bash(git log*)",
        "Bash(npm test*)",
        "Bash(npm run lint*)",
        "Bash(pytest*)",
        "Bash(go test*)",
        "Bash(cargo test*)"
      ]
    },
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "${extensionPath}/hooks/cost-circuit-breaker.sh"
            },
            {
              "type": "command",
              "command": "${extensionPath}/hooks/destructive-command-blocker.sh"
            },
            {
              "type": "command",
              "command": "${extensionPath}/hooks/commit-message-format.sh"
            },
            {
              "type": "command",
              "command": "${extensionPath}/hooks/branch-naming-gate.sh"
            }
          ]
        },
        {
          "matcher": "Write|Edit|MultiEdit|NotebookEdit",
          "hooks": [
            {
              "type": "command",
              "command": "${extensionPath}/hooks/cost-circuit-breaker.sh"
            },
            {
              "type": "command",
              "command": "${extensionPath}/hooks/pii-boundary-check.sh"
            },
            {
              "type": "command",
              "command": "${extensionPath}/hooks/test-files-protector.sh"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Write|Edit",
          "hooks": [
            {
              "type": "command",
              "command": "${extensionPath}/hooks/ai-code-quality-gate.sh"
            },
            {
              "type": "command",
              "command": "${extensionPath}/hooks/jsonl-audit-sink.sh"
            }
          ]
        },
        {
          "matcher": "Write|Edit|MultiEdit",
          "hooks": [
            {
              "type": "command",
              "command": "${extensionPath}/hooks/sdd-schema-gate.sh"
            }
          ]
        },
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "${extensionPath}/hooks/jsonl-audit-sink.sh"
            }
          ]
        }
      ],
      "PreCompact": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "${extensionPath}/hooks/context-integrity-review.sh"
            }
          ]
        }
      ],
      "SubagentStop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "${extensionPath}/hooks/subagent-stop-validator.sh"
            },
            {
              "type": "command",
              "command": "${extensionPath}/hooks/jsonl-audit-sink.sh"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "${extensionPath}/hooks/evidence-bundle-enforcer.sh"
            },
            {
              "type": "command",
              "command": "${extensionPath}/hooks/jsonl-audit-sink.sh"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "${extensionPath}/hooks/prompt-validator.sh"
            },
            {
              "type": "command",
              "command": "${extensionPath}/hooks/slash-command-lint.sh"
            }
          ]
        }
      ],
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "${extensionPath}/hooks/gigacode-md-placeholders.sh"
            }
          ]
        }
      ]
    }
  }
}
